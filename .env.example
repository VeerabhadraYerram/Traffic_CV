# ==============================================================================
# UC4 ANPR Service Configuration — Approach 2 Platform Integration
# ==============================================================================

# ─── SERVICE IDENTIFICATION ───────────────────────────────────────────────────
SERVICE_NAME=uc4-anpr
SERVICE_PORT=8004
ENVIRONMENT=production
LOG_LEVEL=INFO

# ─── REDIS STREAMS (Platform Message Bus) ────────────────────────────────────
REDIS_HOST=innovision-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Ingress: Stream where Platform Ingestion pushes decoded frames
FRAME_STREAM_NAME=streams:frames
FRAME_CONSUMER_GROUP=group:uc4:anpr
FRAME_CONSUMER_ID=anpr-worker-1

# Egress: Stream where UC4 publishes vehicle detections, plates, and violations
ALERT_STREAM_NAME=streams:alerts

# ─── BACKPRESSURE & OVERLOAD CONTROLS ────────────────────────────────────────
# Drop incoming frames older than 150ms to prevent latency lag backlog
MAX_FRAME_AGE_MS=150
# Frames to pull in batch per XREADGROUP call
STREAM_BATCH_SIZE=8

# ─── INFERENCE CONFIGURATION (Layer 4 Shared Inference Server) ───────────────
# Options: "hybrid" (local batching with shared server fallback) | "shared_server" | "local_worker"
INFERENCE_MODE=local_worker
SHARED_INFERENCE_URL=http://innovision-inference:8500/v1/predict

# Local GPU fallback parameters (used when INFERENCE_MODE=local_worker or hybrid)
LOCAL_GPU_DEVICE=0
LOCAL_BATCH_SIZE=8
MAX_CONCURRENT_OCR=3

# ─── PLATFORM API & CAMERA REGISTRY ──────────────────────────────────────────
# Dynamic camera config endpoint (LineZones, speed polygons)
PLATFORM_API_BASE=http://innovision-platform:8000/api/v1
PLATFORM_SERVICE_TOKEN=internal-service-secret
CAMERA_SYNC_INTERVAL_SEC=30

# ─── DATABASE (Isolated UC4 Storage) ─────────────────────────────────────────
# Isolated database for UC4 access logs & violations (does not touch platform core tables)
DATABASE_URL=postgresql://admin:adminpassword@innovision-db:5432/uc4_anpr
DATA_RETENTION_DAYS=30

# ─── LOCAL SNAPSHOT STORAGE ──────────────────────────────────────────────────
SNAPSHOT_DIR=/app/snapshots
