# ==============================================================================
# ANPR System Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ─── DATABASE SETTINGS (Backend & Pipeline) ──────────────────────────────────
# Connection URL for PostgreSQL.
# - Docker format: postgresql://admin:adminpassword@db:5432/traffic
# - Local/Host format: postgresql://admin:adminpassword@localhost:5435/traffic
DATABASE_URL=postgresql://admin:adminpassword@localhost:5435/traffic

# ─── FRONTEND CONFIGURATION (Vite Dashboard App) ─────────────────────────────
# Required for the Vehicle Tracking Map component (/tracking route).
# Obtain a key from the Google Cloud Console with Maps JavaScript API enabled.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
